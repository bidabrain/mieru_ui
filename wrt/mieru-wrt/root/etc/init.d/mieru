#!/bin/sh /etc/rc.common
# Mieru client (mihomo core + mieru) as a transparent proxy for the LAN.

START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/mieru-wrt

start_service() {
	config_load mieru
	local enabled
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	if ! "$PROG" check >/dev/null 2>/tmp/mieru.check; then
		logger -t mieru "配置无效，未启动: $(cat /tmp/mieru.check)"
		return 1
	fi

	procd_open_instance mieru
	procd_set_param command "$PROG" run
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="65535 65535"
	procd_set_param term_timeout 15
	procd_close_instance
}

stop_service() {
	# mieru-wrt removes its rules on SIGTERM; this is a safety net for crashes.
	"$PROG" cleanup >/dev/null 2>&1
}

service_stopped() {
	"$PROG" cleanup >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger mieru
}

reload_service() {
	stop
	start
}
