
config mieru 'main'
	option enabled '0'
	option node ''
	option mode 'bypass_cn'
	option block_ads '0'
	option apple_cn_direct '1'
	option fake_ip '1'
	option sniff '1'
	list direct_dns 'https://doh.pub/dns-query'
	list direct_dns 'https://dns.alidns.com/dns-query'
	list remote_dns 'https://1.1.1.1/dns-query'
	list remote_dns 'https://dns.google/dns-query'
	option dns_hijack '1'
	option access_mode 'all'
	list lan_ifname 'br-lan'
	option tproxy_port '7893'
	option dns_port '7874'
	option mixed_port '0'
	option log_level 'info'
	option geox_source 'jsdelivr'
	option test_url 'https://www.gstatic.com/generate_204'
